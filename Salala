<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111111">
<link rel="manifest" href="manifest.json">
<title>Salala App</title>
<style>
body{margin:0;font-family:Arial;background:#111;color:white}
header{padding:25px;text-align:center;background:#1d1d1d}
h1{color:#d8b15a}
main{padding:18px}
.card{background:#222;border-radius:16px;padding:18px;margin:14px 0}
button{width:100%;padding:14px;margin:7px 0;border:0;border-radius:12px;background:#d8b15a;font-weight:bold}
input{width:100%;padding:12px;margin:6px 0;border-radius:10px;border:0;box-sizing:border-box}
</style>
</head>
<body>
<header>
<h1>🐕 SALALA APP</h1>
<p>Todo para cuidar a tu galgo</p>
</header>

<main>
<div class="card">
<h2>🐾 Mi galgo</h2>
<input id="nombre" placeholder="Nombre de tu galgo">
<input id="raza" placeholder="Raza">
<button onclick="guardar()">Guardar perfil</button>
<p id="perfil"></p>
</div>

<div class="card">
<h2>📚 Guía de razas</h2>
<p><b>Galgo español:</b> rápido, elegante y cariñoso.</p>
<p><b>Greyhound:</b> atlético, tranquilo y sociable.</p>
<p><b>Whippet:</b> pequeño, veloz y afectuoso.</p>
</div>

<div class="card">
<h2>🎂 Edad</h2>
<input id="fecha" type="date">
<button onclick="edad()">Calcular edad</button>
<p id="resultado"></p>
</div>

<div class="card">
<h2>🤰 Gestación</h2>
<p>La gestación canina suele durar alrededor de 63 días.</p>
<input id="cruza" type="date">
<button onclick="gestacion()">Calcular fecha aproximada</button>
<p id="gest"></p>
</div>

<div class="card">
<h2>❤️ Salud</h2>
<p>Recuerda mantener vacunas, controles veterinarios, alimentación, ejercicio y agua al día.</p>
<p>Ante síntomas o dudas de salud, consulta a un veterinario.</p>
</div>
</main>

<script>
function guardar(){
 let n=document.getElementById("nombre").value;
 let r=document.getElementById("raza").value;
 localStorage.perfil=JSON.stringify({n,r});
 mostrar();
}
function mostrar(){
 if(localStorage.perfil){
  let p=JSON.parse(localStorage.perfil);
  document.getElementById("perfil").innerText="🐕 "+p.n+" — "+p.r;
 }
}
function edad(){
 let f=new Date(document.getElementById("fecha").value);
 let hoy=new Date();
 let años=hoy.getFullYear()-f.getFullYear();
 if(hoy.getMonth()<f.getMonth() ||
 (hoy.getMonth()==f.getMonth()&&hoy.getDate()<f.getDate())) años--;
 document.getElementById("resultado").innerText="Edad aproximada: "+años+" años";
}
function gestacion(){
 let f=new Date(document.getElementById("cruza").value);
 f.setDate(f.getDate()+63);
 document.getElementById("gest").innerText="Fecha aproximada: "+f.toLocaleDateString("es-CL");
}
mostrar();
if("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js");
</script>
</body>
</html>